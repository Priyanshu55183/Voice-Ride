# ──────────────────────────────────────────────
# VoiceRide Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── Polling ──
POLL_INTERVAL_SECONDS=4
MAX_POLL_COUNT=75

# ── Uber ──
UBER_HEADLESS=false
UBER_USER_DATA_DIR=./data/uber_session

# ── Retry ──
CANCEL_MAX_RETRIES=3
CANCEL_BACKOFF_BASE=2.0

# ── Logging ──
LOG_LEVEL=INFO
LOG_DIR=./logs

# ── Database ──
DATABASE_PATH=./data/voiceride.db

# ── LLM (Phase 2 — set your API key for the provider you want to use) ──
LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=gpt-4o-mini
LLM_MODEL_ANTHROPIC=claude-sonnet-4-20250514

# ── Voice (Phase 2) ──
# Language hint for Whisper API (leave empty for auto-detect)
# WHISPER_LANGUAGE=en
# Seconds of silence after speech before stopping recording
SILENCE_TIMEOUT=1.5

# ── TTS (Phase 2 — text-to-speech) ──
TTS_RATE=175
TTS_VOLUME=0.9
TTS_ENABLED=true

# ── Appium (Phase 3 — uncomment when ready) ──
# APPIUM_HOST=http://localhost:4723

# ── Telegram (optional fallback notifications) ──
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

